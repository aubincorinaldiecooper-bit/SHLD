# Database
DATABASE_URL="postgresql://shld:shld_dev_password@localhost:5432/shld_dev"

# Redis / job queue
REDIS_URL="redis://localhost:6379"

# Session / token signing
SESSION_SECRET="change-me-in-production"
API_KEY_PEPPER="change-me-in-production"

# GitHub App
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# Outbound webhook signing
WEBHOOK_SIGNING_SECRET="change-me-in-production"

# Engine execution mode: "mock" (default, no external binaries) or "cli"
DEEPSEC_EXECUTION_MODE="mock"
STRIX_EXECUTION_MODE="mock"

# Artifact storage (local filesystem path for beta)
ARTIFACT_STORAGE_DIR="./.artifacts"
